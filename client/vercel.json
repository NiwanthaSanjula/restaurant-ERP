{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm ci --include=dev",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/((?!portfolio-assets/|assets/|fonts/|icons/).*)", "destination": "/index.html" }]
}
