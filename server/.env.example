# Local values below are placeholders; set real values in the hosting environment.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/dilshani_db
JWT_SECRET=replace-with-a-strong-random-server-only-secret
# Exact client origin(s), comma separated; production and preview must be explicit.
FRONTEND_URL=http://localhost:5173
APP_TIME_ZONE=Asia/Colombo
# Local single-process use only: memory. Required in Vercel/production: mongodb.
DEMO_SESSION_STORE=memory

# Optional mail fallback; ordinary browsing/demo never sends email.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=
# Optional first-user provisioning only; never expose to the browser.
# INITIAL_RUN_SECRET=
